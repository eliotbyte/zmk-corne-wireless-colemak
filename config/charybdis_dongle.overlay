#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

/ {
    // Temp-layer processor used to activate the keyboard "mouse_layer"
    // while trackball is moving.
    pointer_auto_layer: pointer_auto_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <150>;
    };
};

// Apply pointing processors to the listener that turns trackball reports into HID.
&trackball_listener {
    // mouse_layer = 2, scroll_layer = 6, mouse_shift_layer = 7 (from config/charybdis.keymap)
    input-processors = <&pointer_auto_layer 2 850 &zip_xy_scaler 2 5>;

    slow_pointer {
        layers = <7>;
        input-processors = <&pointer_auto_layer 2 850 &zip_xy_scaler 1 5>;
    };

    scroller {
        layers = <6>;
        input-processors = <&zip_xy_to_scroll_mapper
            &zip_scroll_scaler 1 48
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };
};


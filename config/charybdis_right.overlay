#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&trackball {
    /delete-property/ irq-gpios;
    /delete-property/ cpi;
    /delete-property/ evt-type;
    /delete-property/ x-input-code;
    /delete-property/ y-input-code;
    motion-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    zephyr,axis-x = <INPUT_REL_X>;
    zephyr,axis-y = <INPUT_REL_Y>;
    res-cpi = <800>;
    // Match input direction expectations (cursor + scroll baseline).
    invert-x;
    invert-y;
};

&trackball_split {
    status = "disabled";
};

/ {
    split_inputs {
        trackball_input: trackball_input@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            status = "okay";
            device = <&trackball>;
        };
    };

    // Temp-layer processor instance with custom idle requirement.
    pointer_auto_layer: pointer_auto_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <150>;
    };
};

// Pointing pipeline for trackball events:
// - auto enable `mouse_layer` on movement
// - scale cursor speed
// - switch to scroll mode on `scroll_layer`, with Y inversion
&trackball_listener {
    // Layer indices (based on this repo's keymap):
    // mouse_layer = 2, scroll_layer = 6, mouse_shift_layer = 7
    input-processors = <&pointer_auto_layer 2 850 &zip_xy_scaler 2 5>;

    slow_pointer {
        layers = <7>;
        input-processors = <&pointer_auto_layer 2 850 &zip_xy_scaler 1 5>;
    };

    scroller {
        layers = <6>;
        input-processors = <&zip_xy_to_scroll_mapper
            &zip_scroll_scaler 1 48
            &zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)
        >;
    };
};
